                        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
                    end)
                end

                -- Setup Teleport Failure / Init Connection fallback
                local connection
                connection = TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
                    if player == localPlayer then
                        if connection then connection:Disconnect() end
                        restoreUI()
                        localPlayer:Kick("This game doesn't allow joining other games. You can join manually. The script has been copied to your clipboard so you don't lose it.")
                    end
                end)

                -- Perform the Teleport
                local success, err = pcall(function()
                    TeleportService:Teleport(targetPlaceId, localPlayer)
                end)

                if not success then
                    if connection then connection:Disconnect() end
                    restoreUI()
                    localPlayer:Kick("This game doesn't allow joining other games. You can join manually. The script has been copied to your clipboard so you don't lose it.")
                end
            end)
        end)
    end
    
    addGameItem("Murder Mystery 2", "Universal MM2 GUI", 142823291, Color3.fromRGB(230, 50, 50))
    addGameItem("Adopt Me!", "Sodium ADM Script", 920587237, Color3.fromRGB(50, 180, 230))
    addGameItem("Grow a Garden 2", "GAG2 v1 Script", 97598239454123, Color3.fromRGB(50, 230, 100))
    addGameItem("Blade Ball", "BladeBall v1 Script", 13772394625, Color3.fromRGB(230, 150, 50))
    addGameItem("Steal a Brainrot", "SAB Script & Stealer", 7197666226, Color3.fromRGB(180, 50, 230))
    
    -- Adjust canvas size based on content
    scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, uiListLayout.AbsoluteContentSize.Y + 10)
    uiListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, uiListLayout.AbsoluteContentSize.Y + 10)
    end)
    
    -- Closing logic
    closeButton.MouseButton1Click:Connect(function()
        guiActive = false
        local info = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        local closeTween = TweenService:Create(mainFrame, info, {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)})
        closeTween:Play()
        closeTween.Completed:Connect(function()
            screenGui:Destroy()
        end)
    end)
    
    -- Hover effect for close button
    closeButton.MouseEnter:Connect(function()
        TweenService:Create(closeButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(220, 80, 80), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        TweenService:Create(closeStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(255, 100, 100)}):Play()
    end)
    closeButton.MouseLeave:Connect(function()
        TweenService:Create(closeButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(24, 20, 25), TextColor3 = Color3.fromRGB(220, 80, 80)}):Play()
        TweenService:Create(closeStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(50, 30, 35)}):Play()
    end)
    
    -- Open animation
    mainFrame.Size = UDim2.new(0, 0, 0, 0)
    mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    screenGui.Parent = playerGui
    
    local openTween = TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 420, 0, 390), Position = UDim2.new(0.5, -210, 0.5, -195)})
    openTween:Play()
end

